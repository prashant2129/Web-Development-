<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Creative DOM Example</title>

<style>
body{
margin:0;
padding:0;
font-family:Arial, sans-serif;
background:linear-gradient(to right,#667eea,#764ba2);
height:100vh;
display:flex;
justify-content:center;
align-items:center;
}

.container{
background:white;
padding:40px;
border-radius:20px;
box-shadow:0 10px 25px rgba(0,0,0,0.3);
text-align:center;
width:400px;
}

h1{
color:#333;
margin-bottom:20px;
}

p{
font-size:18px;
color:#555;
min-height:60px;
}

button{
background:#6a11cb;
color:white;
border:none;
padding:12px 25px;
font-size:16px;
border-radius:30px;
cursor:pointer;
transition:0.3s;
}

button:hover{
background:#2575fc;
transform:scale(1.05);
}
</style>

<script>
function changeContent(){
document.getElementById("message").innerHTML=
"🚀 Welcome to Web Development Lab using JavaScript DOM!";
}
</script>

</head>

<body>

<div class="container">

<h1>✨ JavaScript DOM Example</h1>

<p id="message">Click the button to reveal something amazing.</p>

<button onclick="changeContent()">Click Me</button>

</div>

</body>
</html>
