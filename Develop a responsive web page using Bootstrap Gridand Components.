<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Creative Bootstrap Webpage</title>

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body{
background:linear-gradient(to right,#1e3c72,#2a5298);
font-family:Arial,sans-serif;
}

.hero{
padding:100px 20px;
text-align:center;
color:white;
}

.hero h1{
font-size:55px;
font-weight:bold;
}

.hero p{
font-size:20px;
margin-bottom:25px;
}

.card{
border:none;
border-radius:20px;
overflow:hidden;
transition:0.4s;
box-shadow:0 8px 20px rgba(0,0,0,0.2);
}

.card:hover{
transform:translateY(-10px);
}

.card img{
height:220px;
object-fit:cover;
}

footer{
background:#111;
color:white;
}
</style>

</head>

<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
<div class="container">

<a class="navbar-brand fw-bold" href="#">🌟 My Creative Site</a>

<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
<span class="navbar-toggler-icon"></span>
</button>

<div class="collapse navbar-collapse" id="menu">
<ul class="navbar-nav ms-auto">

<li class="nav-item"><a class="nav-link active" href="#">Home</a></li>
<li class="nav-item"><a class="nav-link" href="#">Gallery</a></li>
<li class="nav-item"><a class="nav-link" href="#">Services</a></li>
<li class="nav-item"><a class="nav-link" href="#">Contact</a></li>

</ul>
</div>

</div>
</nav>

<!-- Hero Section -->
<section class="hero">
<div class="container">
<h1>Build Something Amazing</h1>
<p>Creative Responsive Website using Bootstrap Grid & Components</p>
<button class="btn btn-warning btn-lg px-4">Explore Now</button>
</div>
</section>

<!-- Cards -->
<div class="container mb-5">
<div class="row g-4">

<div class="col-md-4">
<div class="card">
<img src="https://picsum.photos/400/250?1">
<div class="card-body text-center">
<h4>Design</h4>
<p>Modern and elegant UI for all devices.</p>
<button class="btn btn-primary">View</button>
</div>
</div>
</div>

<div class="col-md-4">
<div class="card">
<img src="https://picsum.photos/400/250?2">
<div class="card-body text-center">
<h4>Development</h4>
<p>Responsive layouts powered by Bootstrap.</p>
<button class="btn btn-success">Read</button>
</div>
</div>
</div>

<div class="col-md-4">
<div class="card">
<img src="https://picsum.photos/400/250?3">
<div class="card-body text-center">
<h4>Launch</h4>
<p>Take your project live beautifully.</p>
<button class="btn btn-danger">Start</button>
</div>
</div>
</div>

</div>
</div>

<!-- Footer -->
<footer class="text-center p-4">
<p>© 2026 Creative Bootstrap Website | Made with ❤</p>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
